common --enable_bzlmod
# RCR first so its ROS modules (e.g. urdfdom) take precedence over BCR.
common --registry=https://openrobotics.github.io/ros-central-registry
common --registry=https://bcr.bazel.build
build --output_filter=^//
build --copt=-DGLEW_NO_GLU
build --cxxopt=-std=c++23
build --repo_env=CC=clang
build --repo_env=CXX=clang++
build --action_env=CPLUS_INCLUDE_PATH=""
build --action_env=C_INCLUDE_PATH=""
build --copt=-Iexternal/abseil-cpp+
build --copt=-Werror=thread-safety-analysis