module(
    name = "motorium",
    version = "0.1.0",
)

bazel_dep(name = "rules_cc", version = "0.2.16")
bazel_dep(name = "apple_support", version = "1.24.5")

apple_cc_configure = use_extension("@apple_support//crosstool:setup.bzl", "apple_cc_configure_extension")
use_repo(apple_cc_configure, "local_config_apple_cc_toolchains")

register_toolchains("@local_config_apple_cc_toolchains//:all")

# Hermetic LLVM/clang toolchain: Bazel downloads a pinned LLVM release instead of using the system
# compiler, so every machine and CI runner builds with the same clang. Registered after the Apple
# toolchain, which keeps precedence on macOS. Links the host's libstdc++ (dynamic-stdc++) rather
# than LLVM's libc++, matching the colcon build.
bazel_dep(name = "toolchains_llvm", version = "1.11.3")

llvm = use_extension("@toolchains_llvm//toolchain/extensions:llvm.bzl", "llvm")
llvm.toolchain(
    llvm_version = "19.1.7",
    stdlib = {"": "dynamic-stdc++"},
)
use_repo(llvm, "llvm_toolchain")

register_toolchains("@llvm_toolchain//:all")

bazel_dep(name = "eigen", version = "3.4.0.bcr.3")
bazel_dep(name = "abseil-cpp", version = "20250814.1", repo_name = "com_google_absl")
bazel_dep(name = "googletest", version = "1.17.0.bcr.2")
bazel_dep(name = "glfw", version = "3.4.0.bcr.1")
bazel_dep(name = "glew", version = "2.3.1.bcr.1")
bazel_dep(name = "pugixml", version = "1.15")
bazel_dep(name = "urdfdom", version = "6.0.0-3.rcr.1")
bazel_dep(name = "mujoco", version = "3.15.0")

bazel_dep(name = "magic_enum", version = "0.9.8")

bazel_dep(name = "rules_python", version = "1.7.0")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    ignore_root_user_error = True,
    python_version = "3.10",
)
