<mujoco model="arx_arm">
  <compiler angle="radian"/>
  <option integrator="RK4" iterations="50" solver="Newton"/>

  <asset>
    <mesh name="base_link" file="base_link.STL"/>
    <mesh name="link1" file="link1.STL"/>
    <mesh name="link2" file="link2.STL"/>
    <mesh name="link3" file="link3.STL"/>
    <mesh name="link4" file="link4.STL"/>
    <mesh name="link5" file="link5.STL"/>
  </asset>

  <worldbody>
  </worldbody>

  <actuator>
    <motor name="joint1" joint="joint1" ctrlrange="-500 500" ctrllimited="true"/>
    <motor name="joint2" joint="joint2" ctrlrange="-500 500" ctrllimited="true"/>
    <motor name="joint3" joint="joint3" ctrlrange="-500 500" ctrllimited="true"/>
    <motor name="joint4" joint="joint4" ctrlrange="-500 500" ctrllimited="true"/>
    <motor name="joint5" joint="joint5" ctrlrange="-500 500" ctrllimited="true"/>
    <!-- <motor name="joint6" joint="joint6" ctrlrange="-100 100" ctrllimited="true"/> -->
  </actuator>

  <contact>
    <exclude name="link1_link2" 
      body1="link1"
      body2="link2"
      />
  </contuct>

</mujoco>
