<?xml version="1.0"?>
<!-- Floating-base table on four vertical legs, each with one hip pitch joint. Only the feet (2 cm
     spheres at the leg tips) collide. With the hips at zero the base center stands at
     z = 0.05 + 0.2 + 0.02 = 0.27 m. No floating joint: Drake adds the free base. -->
<robot name="quadruped">
  <link name="base">
    <inertial>
      <mass value="4.0"/>
      <!-- solid box 0.4 x 0.3 x 0.1 m -->
      <inertia ixx="0.0333" ixy="0" ixz="0" iyy="0.0567" iyz="0" izz="0.0833"/>
    </inertial>
    <visual>
      <geometry>
        <box size="0.4 0.3 0.1"/>
      </geometry>
    </visual>
  </link>

  <link name="FL_leg">
    <inertial>
      <origin xyz="0 0 -0.1"/>
      <mass value="0.25"/>
      <inertia ixx="0.00085" ixy="0" ixz="0" iyy="0.00085" iyz="0" izz="0.00005"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.1"/>
      <geometry><cylinder radius="0.015" length="0.2"/></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 -0.2"/>
      <geometry><sphere radius="0.02"/></geometry>
    </collision>
  </link>
  <joint name="FL_hip" type="revolute">
    <parent link="base"/>
    <child link="FL_leg"/>
    <origin xyz="0.15 0.1 -0.05"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.5" upper="1.5" effort="20" velocity="30"/>
  </joint>

  <link name="FR_leg">
    <inertial>
      <origin xyz="0 0 -0.1"/>
      <mass value="0.25"/>
      <inertia ixx="0.00085" ixy="0" ixz="0" iyy="0.00085" iyz="0" izz="0.00005"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.1"/>
      <geometry><cylinder radius="0.015" length="0.2"/></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 -0.2"/>
      <geometry><sphere radius="0.02"/></geometry>
    </collision>
  </link>
  <joint name="FR_hip" type="revolute">
    <parent link="base"/>
    <child link="FR_leg"/>
    <origin xyz="0.15 -0.1 -0.05"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.5" upper="1.5" effort="20" velocity="30"/>
  </joint>

  <link name="RL_leg">
    <inertial>
      <origin xyz="0 0 -0.1"/>
      <mass value="0.25"/>
      <inertia ixx="0.00085" ixy="0" ixz="0" iyy="0.00085" iyz="0" izz="0.00005"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.1"/>
      <geometry><cylinder radius="0.015" length="0.2"/></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 -0.2"/>
      <geometry><sphere radius="0.02"/></geometry>
    </collision>
  </link>
  <joint name="RL_hip" type="revolute">
    <parent link="base"/>
    <child link="RL_leg"/>
    <origin xyz="-0.15 0.1 -0.05"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.5" upper="1.5" effort="20" velocity="30"/>
  </joint>

  <link name="RR_leg">
    <inertial>
      <origin xyz="0 0 -0.1"/>
      <mass value="0.25"/>
      <inertia ixx="0.00085" ixy="0" ixz="0" iyy="0.00085" iyz="0" izz="0.00005"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.1"/>
      <geometry><cylinder radius="0.015" length="0.2"/></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 -0.2"/>
      <geometry><sphere radius="0.02"/></geometry>
    </collision>
  </link>
  <joint name="RR_hip" type="revolute">
    <parent link="base"/>
    <child link="RR_leg"/>
    <origin xyz="-0.15 -0.1 -0.05"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.5" upper="1.5" effort="20" velocity="30"/>
  </joint>
</robot>
